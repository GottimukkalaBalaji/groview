# ==============================================================================
# Grovastra Backend Environment Configuration (.env.example)
# Copy this file to .env for local development:
# Windows (PowerShell): Copy-Item .env.example .env
# Windows (CMD):        copy .env.example .env
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Connection Strings
# Obtained from: https://supabase.com/dashboard/project/<PROJECT_ID>/settings/database
# ------------------------------------------------------------------------------
# Connection pooling (Transaction mode, port 6543) for application queries
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"

# Direct connection (Session mode / direct, port 5432) required by Prisma CLI for migrations
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# Upstash Redis Connection String
# Obtained from: https://console.upstash.com/redis/<DATABASE_ID>
# ------------------------------------------------------------------------------
# Format: rediss://default:[YOUR_UPSTASH_PASSWORD]@[YOUR_UPSTASH_ENDPOINT]:6379
REDIS_URL="rediss://default:placeholder_token@placeholder.upstash.io:6379"

# ------------------------------------------------------------------------------
# Meta WhatsApp Cloud API (Test Account)
# Obtained from: https://developers.facebook.com/apps/<APP_ID>/whatsapp-business/wa-dev-console/
# ------------------------------------------------------------------------------
# Permanent system user or 24h temporary test access token
META_WHATSAPP_ACCESS_TOKEN="placeholder_meta_whatsapp_access_token"

# Test Phone Number ID from WhatsApp Getting Started dashboard
META_PHONE_NUMBER_ID="placeholder_phone_number_id"

# WhatsApp Business Account ID (WABA ID)
META_WABA_ID="placeholder_waba_id"

# Custom secret token created by you to verify Webhook subscription in Meta App Dashboard
META_WEBHOOK_VERIFY_TOKEN="placeholder_webhook_verify_token"

# App Secret found under App Settings -> Basic in Meta App Dashboard (used for HMAC payload verification)
META_APP_SECRET="placeholder_meta_app_secret"

# Meta Graph API Version (e.g., v22.0 or v26.0)
META_GRAPH_API_VERSION="v22.0"

# Verified test recipient phone number in international E.164 format without leading + (e.g., 919876543210)
META_TEST_RECIPIENT_PHONE="placeholder_verified_test_recipient_number"

# ------------------------------------------------------------------------------
# Application Encryption Key (Phase 6A: AES-256-GCM for Multi-Tenant Credentials at Rest)
# ------------------------------------------------------------------------------
# 256-bit (32-byte) hex-encoded key (64 characters).
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY="placeholder_64_character_hex_key"

# ------------------------------------------------------------------------------
# Automatic WhatsApp Dispatch Worker Subsystem
# ------------------------------------------------------------------------------
# Set to true to automatically start the BullMQ WhatsApp dispatch worker on backend startup.
# Concurrency is strictly 1. Worker automatically claims and dispatches queued campaign messages.
# Default: false (worker dormant until explicitly enabled)
ENABLE_AUTOMATIC_WORKER="false"
